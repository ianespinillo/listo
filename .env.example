# Copiar a .env (no se sube a git): cp .env.example .env
# Todas las variables se leen al arrancar el servidor (src/server.ts carga .env con dotenv).
# En producción también se pueden definir como variables de entorno del sistema o del servicio.

# --- Base de datos ---

# Base de desarrollo (docker compose up -d la levanta en el puerto 5434).
# En producción: la URL de tu PostgreSQL, con usuario y contraseña propios.
DATABASE_URL="postgresql://listo:listo@localhost:5434/listo"

# Base descartable para los tests (puerto 5433, base listo_test). pnpm test se niega a correr
# contra cualquier otra. Solo hace falta en desarrollo.
DATABASE_URL_TEST="postgresql://listo:listo@localhost:5433/listo_test"

# --- Datos de la escuela (se muestran en el formulario y en el panel) ---

SCHOOL_NAME="E.E.S. N.º [número] · [distrito]"
SCHOOL_CONTACT="[teléfono o email de la escuela]"

# --- Servidor ---

# "production" en el servidor: activa la cookie de sesión "secure" (solo viaja por HTTPS).
NODE_ENV="development"

# Puerto donde escucha Express. Por defecto 4000.
PORT=4000

# Dominios con los que se puede entrar, separados por coma (sin https:// ni barras).
# En producción es OBLIGATORIO: Angular rechaza cualquier Host que no esté en esta lista.
# Se suma a localhost y 127.0.0.1, que ya vienen permitidos desde angular.json.
# Ejemplo: NG_ALLOWED_HOSTS="listo.miescuela.edu.ar,www.listo.miescuela.edu.ar"
NG_ALLOWED_HOSTS=

# Cantidad de proxies de confianza delante del servidor (para el límite de intentos por IP).
# Vacío = apagado. Un número = saltos a confiar (recomendado: 1 con un solo nginx).
# "true" = confiar en cualquier X-Forwarded-For (permite falsear la IP: evitarlo).
TRUST_PROXY=

# --- Solo para el script pnpm create-admin (opcionales) ---

# Si se definen las dos, el script no pregunta nada (útil para automatizar). Si no, las pide por consola.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
