# Copiar a .env (no se sube a git)

DATABASE_URL="postgresql://listo:listo@localhost:5434/listo"
DATABASE_URL_TEST="postgresql://listo:listo@localhost:5433/listo_test"

# Datos de la escuela que se muestran en el formulario
SCHOOL_NAME="E.E.S. N.º [número] · [distrito]"
SCHOOL_CONTACT="[teléfono o email de la escuela]"

# Zona horaria para evaluar el plazo de inscripción
TIME_ZONE="America/Argentina/Buenos_Aires"

# production en el servidor (activa cookie secure)
NODE_ENV="development"
PORT=4000
