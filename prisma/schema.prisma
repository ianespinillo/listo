// Listo — modelo de datos (Prisma 7 + PostgreSQL)
// La URL de la base está en prisma.config.ts, no acá.
// Modelos y campos en español (dominio); tablas, columnas y tipos de la base en inglés (@map / @@map).

generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoPuesto {
  ASIGNATURA
  CARGO

  @@map("position_type")
}

enum SituacionRevista {
  TITULAR
  PROVISIONAL
  SUPLENTE
  EXTERNO

  @@map("employment_status")
}

enum Turno {
  MANANA
  TARDE
  VESPERTINO

  @@map("shift")
}

enum TipoEvento {
  INSCRIPCION
  CAMBIO_DATOS     // cambió situación de revista o antigüedad
  CAMBIO_PUNTAJE
  ALTA_MATERIA
  BAJA_MATERIA
  VERIFICACION
  DESVERIFICACION
  CAMBIO_EMAIL     // lo hizo la directora desde el panel
  BAJA
  REACTIVACION

  @@map("event_type")
}

model Ciclo {
  id               Int          @id @default(autoincrement())
  anio             Int          @unique @map("year")
  inscripcionDesde DateTime     @map("registration_from") @db.Date
  inscripcionHasta DateTime     @map("registration_until") @db.Date
  // Un solo ciclo activo: índice único parcial en migración manual (ver docs/plan.md, Etapa 1)
  activo           Boolean      @default(false) @map("active")
  creadoEn         DateTime     @default(now()) @map("created_at")
  postulantes      Postulante[]

  @@map("cycle")
}

model Puesto {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique @map("name")
  tipo          TipoPuesto    @map("type")
  // Un puesto con postulaciones no se borra: se desactiva
  activo        Boolean       @default(true) @map("active")
  postulaciones Postulacion[]
  eventos       Evento[]

  @@map("position")
}

model Postulante {
  id               Int              @id @default(autoincrement())
  cicloId          Int              @map("cycle_id")
  ciclo            Ciclo            @relation(fields: [cicloId], references: [id])
  dni              String           // solo dígitos
  apellido         String           @map("last_name")
  nombre           String           @map("first_name")
  email            String           // normalizado: trim + minúsculas
  telefono         String           @map("phone")
  situacionRevista SituacionRevista @map("employment_status")
  antiguedadMeses  Int              @map("seniority_months")
  turnos           Turno[]          @map("shifts")
  dadoDeBaja       Boolean          @default(false) @map("deactivated")
  creadoEn         DateTime         @default(now()) @map("created_at")
  actualizadoEn    DateTime         @updatedAt @map("updated_at")
  postulaciones    Postulacion[]
  eventos          Evento[]

  @@unique([cicloId, dni])
  @@index([cicloId, dadoDeBaja])
  @@map("applicant")
}

model Postulacion {
  postulanteId    Int        @map("applicant_id")
  postulante      Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  puestoId        Int        @map("position_id")
  puesto          Puesto     @relation(fields: [puestoId], references: [id])
  puntaje         Decimal    @map("score") @db.Decimal(5, 2)
  verificado      Boolean    @default(false) @map("verified")
  // true cuando el docente cambió el puntaje después de la última verificación
  modificado      Boolean    @default(false) @map("modified")
  // puntaje previo al último cambio; se limpia al verificar
  puntajeAnterior Decimal?   @map("previous_score") @db.Decimal(5, 2)
  verificadoEn    DateTime?  @map("verified_at")

  @@id([postulanteId, puestoId])
  @@index([puestoId])
  @@map("application")
}

model Evento {
  id           Int        @id @default(autoincrement())
  postulanteId Int        @map("applicant_id")
  postulante   Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  tipo         TipoEvento @map("type")
  puestoId     Int?       @map("position_id")
  puesto       Puesto?    @relation(fields: [puestoId], references: [id])
  // valores anterior/nuevo según el tipo, p. ej. { "anterior": "36.10", "nuevo": "38.45" }
  detalle      Json?      @map("detail")
  fecha        DateTime   @default(now()) @map("occurred_at")

  @@index([postulanteId, fecha])
  @@map("event")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  creadoEn     DateTime @default(now()) @map("created_at")
  sesiones     Sesion[]

  @@map("admin")
}

model Sesion {
  // SHA-256 del token de la cookie; el token en claro nunca se guarda
  tokenHash String   @id @map("token_hash")
  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiraEn  DateTime @map("expires_at")
  creadoEn  DateTime @default(now()) @map("created_at")

  @@index([expiraEn])
  @@map("session")
}
