// Listo — modelo de datos (Prisma 7 + PostgreSQL)
// La URL de la base está en prisma.config.ts, no acá.
// Modelos, campos y enums en inglés; los valores de enums del decreto quedan en español.
// Tablas, columnas y tipos de la base en inglés (@map / @@map).

generator client {
  provider        = "prisma-client"
  output          = "../src/server/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PositionType {
  ASIGNATURA
  CARGO

  @@map("position_type")
}

enum EmploymentStatus {
  TITULAR
  PROVISIONAL
  SUPLENTE
  EXTERNO

  @@map("employment_status")
}

enum Shift {
  MANANA
  TARDE
  VESPERTINO

  @@map("shift")
}

enum EventType {
  REGISTRATION
  DATA_CHANGE // cambió situación de revista o antigüedad
  SCORE_CHANGE
  POSITION_ADDED
  POSITION_REMOVED
  VERIFICATION
  UNVERIFICATION
  EMAIL_CHANGE // lo hizo la directora desde el panel
  DEACTIVATION
  REACTIVATION

  @@map("event_type")
}

model Cycle {
  id                Int         @id @default(autoincrement())
  year              Int         @unique
  registrationFrom  DateTime    @map("registration_from") @db.Date
  registrationUntil DateTime    @map("registration_until") @db.Date
  // Un solo ciclo activo: índice único parcial cycle_single_active (ver @@unique abajo)
  active            Boolean     @default(false)
  createdAt         DateTime    @default(now()) @map("created_at")
  applicants        Applicant[]

  @@unique([active], map: "cycle_single_active", where: { active: true })
  @@map("cycle")
}

model Position {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  type         PositionType
  // Un puesto con postulaciones no se borra: se desactiva
  active       Boolean        @default(true)
  applications Application[]
  events       HistoryEvent[]

  @@map("position")
}

model Applicant {
  id                    Int              @id @default(autoincrement())
  cycleId               Int              @map("cycle_id")
  cycle                 Cycle            @relation(fields: [cycleId], references: [id])
  dni                   String // solo dígitos
  lastName              String           @map("last_name")
  firstName             String           @map("first_name")
  email                 String // normalizado: trim + minúsculas
  phone                 String
  employmentStatus      EmploymentStatus @map("employment_status")
  seniorityMonths       Int              @map("seniority_months")
  // Antigüedad en esta escuela (meses). Solo titular/provisional/suplente; null para externos
  // y para inscripciones anteriores. Ordena el grupo 1 del listado.
  schoolSeniorityMonths Int?             @map("school_seniority_months")
  shifts                Shift[]
  deactivated           Boolean          @default(false)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  applications          Application[]
  events                HistoryEvent[]

  @@unique([cycleId, dni])
  @@index([cycleId, deactivated])
  @@map("applicant")
}

model Application {
  applicantId   Int       @map("applicant_id")
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  positionId    Int       @map("position_id")
  position      Position  @relation(fields: [positionId], references: [id])
  score         Decimal   @db.Decimal(5, 2)
  verified      Boolean   @default(false)
  // true cuando el docente cambió el puntaje después de la última verificación
  modified      Boolean   @default(false)
  // puntaje previo al último cambio; se limpia al verificar
  previousScore Decimal?  @map("previous_score") @db.Decimal(5, 2)
  verifiedAt    DateTime? @map("verified_at")

  @@id([applicantId, positionId])
  @@index([positionId])
  @@map("application")
}

model HistoryEvent {
  id          Int       @id @default(autoincrement())
  applicantId Int       @map("applicant_id")
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        EventType
  positionId  Int?      @map("position_id")
  position    Position? @relation(fields: [positionId], references: [id])
  // valores anterior/nuevo según el tipo, p. ej. { "previous": "36.10", "new": "38.45" }
  detail      Json?
  occurredAt  DateTime  @default(now()) @map("occurred_at")

  @@index([applicantId, occurredAt])
  @@map("event")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("admin")
}

model Session {
  // SHA-256 del token de la cookie; el token en claro nunca se guarda
  tokenHash String   @id @map("token_hash")
  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("session")
}
